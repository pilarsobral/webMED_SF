@model ErrorAppViewModel
@{
    ViewData["Title"] = "Error";
}


@if (Model.Nivel == "ERROR")
{
    <h1 class="text-danger">Error.</h1>
    <h2 class="text-danger">@Model.Encabezado</h2>
}


@if (Model.Nivel == "AVISO")
{
    <h1 class="text-warning">Aviso.</h1>
    <h2 class="text-warning">@Model.Encabezado</h2>
}


@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>
    @Model.Descripcion
</p>

<p>
    <a asp-area="" asp-controller="@Model.Retorno_Controller" asp-action="@Model.Retorno_Action">Retornar</a>
</p>